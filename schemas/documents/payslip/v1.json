{
  "document_type": "payslip",
  "version": 1,
  "canonical_schema": {
    "$defs": {
      "DatePeriod": {
        "additionalProperties": false,
        "description": "Inclusive calendar interval.",
        "properties": {
          "start_date": {
            "description": "First calendar date included in the reporting or payment period, as YYYY-MM-DD.",
            "format": "date",
            "title": "Start date",
            "type": "string"
          },
          "end_date": {
            "description": "Last calendar date included in the period, as YYYY-MM-DD; must not precede the start date.",
            "format": "date",
            "title": "End date",
            "type": "string"
          }
        },
        "required": [
          "start_date",
          "end_date"
        ],
        "title": "DatePeriod",
        "type": "object"
      },
      "Employer": {
        "additionalProperties": false,
        "description": "Employer identity stated in a document.",
        "properties": {
          "name": {
            "description": "Employer's legal or trading name exactly as printed.",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Employer name",
            "type": "string"
          },
          "registration_number": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Employer registration identifier as printed, preserving formatting and leading zeros; null when absent.",
            "title": "Registration number"
          },
          "address": {
            "anyOf": [
              {
                "$ref": "#/$defs/PostalAddress"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Employer address stated in the document; null when absent.",
            "title": "Employer address"
          }
        },
        "required": [
          "name"
        ],
        "title": "Employer",
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "description": "Exact monetary value; JSON serializes the amount as a decimal string.",
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "description": "Monetary amount in the associated currency, preserving source precision and sign.",
            "title": "Amount"
          },
          "currency": {
            "description": "ISO three-letter currency code for the monetary amount.",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "Money",
        "type": "object"
      },
      "PostalAddress": {
        "additionalProperties": false,
        "description": "An address as printed; policy decides which local components are necessary.",
        "properties": {
          "address_line_1": {
            "description": "Primary street, building, or locality line exactly as stated by the source.",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Address line 1",
            "type": "string"
          },
          "address_line_2": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Additional unit, floor, building, or locality information; null when absent.",
            "title": "Address line 2"
          },
          "city": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "City or locality named in the address; null when absent.",
            "title": "City"
          },
          "region": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "State, province, or administrative region named in the address; null when absent.",
            "title": "Region"
          },
          "postal_code": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Postal code as printed, preserving letters, spaces, and leading zeros; null when absent.",
            "title": "Postal code"
          },
          "country_code": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ISO two-letter country code established by the source or verified reference; null when unknown.",
            "title": "Country code"
          }
        },
        "required": [
          "address_line_1"
        ],
        "title": "PostalAddress",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Structured facts from a payslip.",
    "properties": {
      "document_type": {
        "const": "payslip",
        "default": "payslip",
        "description": "Identifies this payload as payslip.",
        "title": "Document type",
        "type": "string"
      },
      "employee_name": {
        "description": "Employee name exactly as printed on the payslip.",
        "minLength": 1,
        "pattern": "\\S",
        "title": "Employee name",
        "type": "string"
      },
      "employer": {
        "$ref": "#/$defs/Employer",
        "description": "Employer identity stated by the payslip."
      },
      "pay_period": {
        "$ref": "#/$defs/DatePeriod",
        "description": "Inclusive employment/pay period represented by the payslip.",
        "title": "Pay period"
      },
      "payment_date": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Date on which payment is stated to occur.",
        "title": "Payment date"
      },
      "gross_pay": {
        "$ref": "#/$defs/Money",
        "description": "Total pay before deductions, in the stated currency.",
        "title": "Gross pay"
      },
      "net_pay": {
        "$ref": "#/$defs/Money",
        "description": "Amount payable to the employee after deductions.",
        "title": "Net pay"
      },
      "deductions": {
        "anyOf": [
          {
            "$ref": "#/$defs/Money"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Total deductions stated on the payslip; absence is not a zero deduction.",
        "title": "Deductions"
      },
      "employee_identifier": {
        "anyOf": [
          {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Employer-assigned payroll identifier as printed.",
        "title": "Employee identifier"
      }
    },
    "required": [
      "employee_name",
      "employer",
      "pay_period",
      "gross_pay",
      "net_pay"
    ],
    "title": "Payslip",
    "type": "object"
  },
